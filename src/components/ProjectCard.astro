---
interface Props {
  title: string;
  description: string;
  stack: string[];
  github: string;
  demo?: string;
  image?: string;
}

const { title, description, stack, github, demo, image } = Astro.props;
---

<div class="border-t border-rule pt-6">
  <h2 class="text-xl font-bold text-ink mb-2">{title}</h2>
  <p class="text-ink text-sm leading-relaxed mb-4">{description}</p>
  {image && (
    <img
      src={image}
      alt={`${title} screenshot`}
      loading="lazy"
      class="max-w-xs w-full mb-4"
    />
  )}
  <div class="font-mono text-xs text-muted mb-5">
    {stack.join('   ·   ')}
  </div>
  <div class="flex gap-4">
    <a
      href={github}
      target="_blank"
      rel="noopener noreferrer"
      class="text-sm font-medium"
    >
      GitHub →
    </a>
    {demo && (
      <a
        href={demo}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm font-medium"
      >
        Demo →
      </a>
    )}
  </div>
</div>
