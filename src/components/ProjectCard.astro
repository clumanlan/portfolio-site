---
interface Props {
  title: string;
  description: string;
  stack: string[];
  github: string;
  demo: string;
}

const { title, description, stack, github, demo } = Astro.props;
---

<div id="projects" class="border border-gray-200 rounded-lg p-6 hover:border-gray-300 transition-colors">
  <h3 class="font-heading text-xl font-semibold text-gray-900 mb-2">{title}</h3>
  <p class="text-gray-600 text-sm leading-relaxed mb-4">{description}</p>
  <div class="flex flex-wrap gap-2 mb-5">
    {stack.map((tech) => (
      <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-[var(--color-accent-bg)] text-[var(--color-accent)]">
        {tech}
      </span>
    ))}
  </div>
  <div class="flex gap-4">
    <a
      href={github}
      target="_blank"
      rel="noopener noreferrer"
      class="text-sm font-medium text-[var(--color-accent)] hover:text-[var(--color-accent-hover)] transition-colors"
    >
      GitHub →
    </a>
    <a
      href={demo}
      target="_blank"
      rel="noopener noreferrer"
      class="text-sm font-medium text-[var(--color-accent)] hover:text-[var(--color-accent-hover)] transition-colors"
    >
      Demo →
    </a>
  </div>
</div>
