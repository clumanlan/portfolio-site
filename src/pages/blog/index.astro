---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .map((p) => ({
    slug: p.id.replace('/index', ''),
    title: p.data.title,
    date: p.data.date,
    description: p.data.description,
  }));
---

<Base title="Blog — Carlyle Lumanlan">
  <div class="mb-10">
    <h1 class="text-2xl font-bold text-ink mb-1">Writing</h1>
    <p class="text-muted text-sm">learning is continuous, documenting is sporadic.</p>
  </div>

  <!-- Post list -->
  <ul class="space-y-8">
    {posts.map((post) => (
      <li class="border-t border-rule pt-6">
        <a href={`/blog/${post.slug}`} class="group block no-underline">
          <div class="font-mono text-xs text-muted mb-1">{post.date}</div>
          <h2 class="font-bold text-ink mb-1">
            {post.title}
          </h2>
          <p class="text-sm text-muted leading-relaxed">{post.description}</p>
        </a>
      </li>
    ))}
  </ul>

  {posts.length === 0 && (
    <p class="text-muted text-sm">No posts yet.</p>
  )}
</Base>
