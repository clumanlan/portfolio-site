---
import Base from './Base.astro';
import TOC from '../components/TOC.tsx';

interface Props {
  title: string;
  date: string;
  description: string;
}

const { title, date, description } = Astro.props;
---

<Base title={`${title} — Carlyle Lumanlan`} description={description} ogType="article">
  <div class="relative">
    <!-- TOC: sticky left column on large screens -->
    <aside class="hidden xl:block absolute right-full pr-10 top-0 w-52">
      <div class="sticky top-10">
        <TOC client:load />
      </div>
    </aside>

    <!-- Post content -->
    <article class="max-w-2xl mx-auto">
      <!-- Header -->
      <header class="mb-10">
        <div class="font-mono text-xs text-muted mb-3">{date}</div>
        <h1 class="text-3xl font-bold text-ink mb-3 leading-snug">
          {title}
        </h1>
        <p class="text-muted leading-relaxed">{description}</p>
      </header>

      <!-- MDX body -->
      <div class="prose prose-gray max-w-none prose-headings:font-bold prose-a:text-ink">
        <slot />
      </div>
    </article>
  </div>
</Base>

<style is:global>
  /* Headings attach to the content below, not float in the middle */
  .prose :is(h2, h3, h4) {
    margin-bottom: 0.25em !important;
    margin-top: 2em !important;
  }

  .prose :is(h2, h3, h4):first-child {
    margin-top: 0 !important;
  }

  /* Kill the paragraph top margin immediately after a heading */
  .prose :is(h2, h3, h4) + p {
    margin-top: 0 !important;
  }

  /* Full-width D3 breakout: escapes the narrow prose column */
  .full-bleed {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    max-width: 100vw;
    overflow-x: hidden;
  }
</style>
