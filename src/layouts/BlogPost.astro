---
import Base from './Base.astro';
import TOC from '../components/TOC.tsx';

interface Props {
  title: string;
  date: string;
  description: string;
  tags: string[];
}

const { title, date, description, tags } = Astro.props;
---

<Base title={`${title} — Carlyle Lumanlan`} description={description}>
  <div class="relative">
    <!-- TOC: sticky left column on large screens -->
    <aside class="hidden xl:block absolute right-full pr-10 top-0 w-52">
      <div class="sticky top-10">
        <TOC client:load />
      </div>
    </aside>

    <!-- Post content -->
    <article class="max-w-2xl mx-auto">
      <!-- Header -->
      <header class="mb-10">
        <div class="text-xs text-gray-400 mb-3">{date}</div>
        <h1 class="text-3xl font-semibold text-gray-900 mb-3 leading-snug" style="font-family: var(--font-heading)">
          {title}
        </h1>
        <p class="text-gray-500 leading-relaxed mb-4">{description}</p>
        <div class="flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <span class="text-xs px-2 py-0.5 rounded-full" style="background: #e0f5ec; color: #1a7a5e">
              {tag}
            </span>
          ))}
        </div>
      </header>

      <!-- MDX body -->
      <div class="prose prose-gray max-w-none prose-headings:font-semibold prose-a:text-[#1a7a5e] prose-a:no-underline hover:prose-a:underline">
        <slot />
      </div>
    </article>
  </div>
</Base>

<style is:global>
  /* Headings attach to the content below, not float in the middle */
  .prose :is(h2, h3, h4) {
    margin-bottom: 0.25em !important;
    margin-top: 2em !important;
  }

  .prose :is(h2, h3, h4):first-child {
    margin-top: 0 !important;
  }

  /* Kill the paragraph top margin immediately after a heading */
  .prose :is(h2, h3, h4) + p {
    margin-top: 0 !important;
  }

  /* Full-width D3 breakout — escapes the narrow prose column */
  .full-bleed {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    max-width: 100vw;
    overflow-x: hidden;
  }
</style>
